{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/cosmetics-chat.js": {
      "includeFiles": "{catalogues/*-refresh.js,advisor-core.js,catalogue-reply-core.js,catalogue-data.js,chat-brain.js,chat-adapters.js}"
    }
  },
  "rewrites": [
    {
      "source": "/kozmetika/:slug",
      "destination": "/cosmetics.html"
    },
    {
      "source": "/kozmetika/:slug/",
      "destination": "/cosmetics.html"
    },
    {
      "source": "/puaree",
      "destination": "/cosmetics.html?demo=puaree"
    },
    {
      "source": "/mydlitto",
      "destination": "/cosmetics.html?demo=mydlitto"
    },
    {
      "source": "/kvetu",
      "destination": "/cosmetics.html?demo=kvetu"
    },
    {
      "source": "/monlevur",
      "destination": "/cosmetics.html?demo=monlevur"
    },
    {
      "source": "/puaree/",
      "destination": "/cosmetics.html?demo=puaree"
    },
    {
      "source": "/mydlitto/",
      "destination": "/cosmetics.html?demo=mydlitto"
    },
    {
      "source": "/kvetu/",
      "destination": "/cosmetics.html?demo=kvetu"
    },
    {
      "source": "/monlevur/",
      "destination": "/cosmetics.html?demo=monlevur"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/(.*)\\.(html|js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "redirects": [
