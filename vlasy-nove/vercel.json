{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "dixi.mojchatbot.sk"
        }
      ],
      "destination": "/cosmetics.html?demo=dixi"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "vivaco.mojchatbot.sk"
        }
      ],
      "destination": "/cosmetics.html?demo=vivaco"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "kapyderm.mojchatbot.sk"
        }
      ],
      "destination": "/cosmetics.html?demo=kapyderm"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "medarek.mojchatbot.sk"
        }
      ],
      "destination": "/cosmetics.html?demo=medarek"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "andreine.mojchatbot.sk"
        }
      ],
      "destination": "/cosmetics.html?demo=andreine"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "voono.mojchatbot.sk"
        }
      ],
      "destination": "/cosmetics.html?demo=voono"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "navlasil.mojchatbot.sk"
        }
      ],
      "destination": "/cosmetics.html?demo=navlasil"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "ryor.mojchatbot.sk"
        }
      ],
      "destination": "/cosmetics.html?demo=ryor"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "venira.mojchatbot.sk"
        }
      ],
      "destination": "/cosmetics.html?demo=venira"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "havlikova.mojchatbot.sk"
        }
      ],
      "destination": "/cosmetics.html?demo=havlikova"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "haaro.mojchatbot.sk"
        }
      ],
      "destination": "/cosmetics.html?demo=haaro"
    },
    {
      "source": "/",
      "destination": "/zoznam.html"
    },
    {
      "source": "/kozmetika/:slug",
      "destination": "/cosmetics.html"
    },
    {
      "source": "/kozmetika/:slug/",
      "destination": "/cosmetics.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/(.*)\\.(html|js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
